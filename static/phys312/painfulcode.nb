Notebook[{

Cell[CellGroupData[{
Cell["Problem 1(b): Integration only over \[Theta]\[CloseCurlyQuote] (here \
called \[OpenCurlyQuote]x\[CloseCurlyQuote])", "Subtitle",
 CellChangeTimes->{{3.954436146124888*^9, 
  3.954436167385551*^9}},ExpressionUUID->"0dba6ac1-812d-4188-8890-\
9f28d5d6829d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "^", "2"}], " ", "*", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "*", "k", "*", "r", "*", 
      RowBox[{"Cos", "[", "x", "]"}]}], "]"}], "*", 
    RowBox[{"Sin", "[", "x", "]"}], "*", "r", "*", "\[IndentingNewLine]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], "*", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "x", "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Phi]", "-", "\[Chi]"}], "]"}]}]}], ")"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "r"}], "/", "a0"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "Pi"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.954435096029612*^9, 3.954435250337175*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"8b3de216-6335-4fcb-b262-931c080ecd0f"],

Cell[BoxData[
 TemplateBox[{
   RowBox[{
     FractionBox[
      RowBox[{"2", " ", "\[ImaginaryI]", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
           FractionBox["r", "a0"]}]], " ", "r", " ", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"(", 
          RowBox[{
            RowBox[{"k", " ", "r", " ", 
              RowBox[{"Cos", "[", 
                RowBox[{"k", " ", "r"}], "]"}]}], "-", 
            RowBox[{"Sin", "[", 
              RowBox[{"k", " ", "r"}], "]"}]}], ")"}]}], 
      SuperscriptBox["k", "2"]], "+", 
     FractionBox[
      RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
           FractionBox["r", "a0"]}]], " ", "\[Pi]", " ", 
        SuperscriptBox["r", "2"], " ", 
        RowBox[{"BesselJ", "[", 
          RowBox[{"1", ",", 
            RowBox[{"k", " ", "r"}]}], "]"}], " ", 
        RowBox[{"Cos", "[", 
          RowBox[{"\[Phi]", "-", "\[Chi]"}], "]"}], " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "k"]}], 
   RowBox[{
     RowBox[{"k", " ", "r"}], "\[Element]", 
     TemplateBox[{}, "Reals"]}]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.954435290433979*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"a1779392-5263-4312-9964-8e051237082b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Problem 1(b): Integration over all whole given volume", "Subtitle",
 CellChangeTimes->{{3.954436222652935*^9, 
  3.954436233883745*^9}},ExpressionUUID->"e6ffd241-d8f2-4b55-bcdb-\
d2611d6be359"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"r", "^", "2"}], " ", "*", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], "*", "k", "*", "r", "*", 
      RowBox[{"Cos", "[", "x", "]"}]}], "]"}], "*", 
    RowBox[{"Sin", "[", "x", "]"}], "*", "r", "*", "\[IndentingNewLine]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], "*", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "x", "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Phi]", "-", "\[Chi]"}], "]"}]}]}], ")"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "r"}], "/", "a0"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", "0", ",", " ", 
     RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.954435303341638*^9, 3.954435322117552*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"6119d220-578b-48d2-9ced-1203f161e6fa"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"32", " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["a0", "5"], " ", "k", " ", "\[Pi]", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["a0", "2"], " ", 
       SuperscriptBox["k", "2"]}]}], ")"}], "3"]]}]], "Output",
 CellChangeTimes->{3.954435409680646*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"a27890bc-5b7a-4d5a-8911-4b84c1ce44eb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Problem 1(c)", "Subtitle",
 CellChangeTimes->{{3.954437411674919*^9, 
  3.9544374152863407`*^9}},ExpressionUUID->"47a8c255-c69b-4351-aea4-\
36f3e4db49a1"],

Cell["\<\
Square the above expression for using in Fermi Golden Rule magnitude (the i \
\[OpenCurlyQuote]imaginary\[CloseCurlyQuote] can be simply ignored by \
multiplying a -1 as we require absolute value only)\
\>", "Text",
 CellChangeTimes->{{3.954437375522493*^9, 3.954437383659671*^9}, {
  3.954445916721397*^9, 
  3.9544459706531487`*^9}},ExpressionUUID->"9072cd99-0238-4428-8c4f-\
725be55b15d8"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.954445975169465*^9, 
  3.9544459764742727`*^9}},ExpressionUUID->"c4ee36f2-b71c-4a28-904e-\
1efe13e2cebf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{"(", 
    RowBox[{"2", "*", 
     RowBox[{"Pi", "/", "h"}]}], ")"}]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"e", "*", 
       RowBox[{"E0", "/", 
        RowBox[{"(", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"(", 
           RowBox[{"Pi", "*", 
            RowBox[{"a0", "^", "3"}], "*", 
            RowBox[{"L", "^", "3"}]}], ")"}], "]"}], ")"}]}]}], ")"}], 
     FractionBox[
      RowBox[{"32", " ", "\[ImaginaryI]", " ", 
       SuperscriptBox["a0", "5"], " ", "k", " ", "\[Pi]", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          SuperscriptBox["a0", "2"], " ", 
          SuperscriptBox["k", "2"]}]}], ")"}], "3"]]}], ")"}], "^", "2"}], 
  "*", 
  RowBox[{"(", 
   RowBox[{"m", " ", "*", " ", 
    RowBox[{
     RowBox[{"L", "^", "3"}], " ", "/", 
     RowBox[{"(", 
      RowBox[{"8", " ", 
       RowBox[{"pi", "^", "3"}], " ", 
       RowBox[{"h", "^", "2"}]}], ")"}]}], " ", "k"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.954437362314411*^9, 3.954437369505875*^9}, {
   3.9544375075609827`*^9, 3.954437633326069*^9}, {3.954437781264114*^9, 
   3.9544377884984207`*^9}, {3.9544378907540607`*^9, 3.954437920405024*^9}, {
   3.9544456421169*^9, 3.954445678427307*^9}, {3.954445896898838*^9, 
   3.954445909030127*^9}, 3.954445981543521*^9},
 CellLabel->"In[19]:=",ExpressionUUID->"614eb221-b60c-4818-9f39-2c777ba59312"],

Cell[BoxData[
 FractionBox[
  RowBox[{"256", " ", 
   SuperscriptBox["a0", "7"], " ", 
   SuperscriptBox["e", "2"], " ", 
   SuperscriptBox["E0", "2"], " ", 
   SuperscriptBox["k", "3"], " ", "m", " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], 
  RowBox[{
   SuperscriptBox["h", "3"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["a0", "2"], " ", 
       SuperscriptBox["k", "2"]}]}], ")"}], "6"], " ", 
   SuperscriptBox["pi", "3"]}]]], "Output",
 CellChangeTimes->{{3.9544456536605663`*^9, 3.954445681508272*^9}, 
   3.954445910488826*^9, 3.9544459823756332`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"d6a03701-9a12-4bd0-9a17-9a02b4d0cef1"]
}, Open  ]],

Cell["\<\
Comment: We have a cos(theta)^2 dependence for the differential transition \
rate. The differential is taken with respect to the solid angle differential \
as discussed in the PS Notes. At theta = 90 we can see that the probability \
is 0 which physically makes sense because the Electric Field is then \
perpendicular to the wave vector. \
\>", "Text",
 CellChangeTimes->{{3.95444602540849*^9, 3.954446087925356*^9}, {
  3.954446170323844*^9, 
  3.954446201835311*^9}},ExpressionUUID->"0434b046-b68b-468a-8aa2-\
9dc36da52f8d"],

Cell["", "Text",
 CellChangeTimes->{
  3.9544380164376802`*^9, {3.954445987282022*^9, 
   3.95444601831575*^9}},ExpressionUUID->"d1773b86-df4b-44f0-bce2-\
cc3d81bdde5e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Problem 1(d)", "Subtitle",
 CellChangeTimes->{{3.95444614758251*^9, 
  3.954446149332543*^9}},ExpressionUUID->"3370ed3d-2aa1-4ddc-923a-\
43cf7313c793"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     FractionBox[
      RowBox[{"256", " ", 
       SuperscriptBox["a0", "7"], " ", 
       SuperscriptBox["e", "2"], " ", 
       SuperscriptBox["E0", "2"], " ", 
       SuperscriptBox["k", "3"], " ", "m", " ", 
       SuperscriptBox["\[Pi]", "2"], " ", 
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], 
      RowBox[{
       SuperscriptBox["h", "3"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           SuperscriptBox["a0", "2"], " ", 
           SuperscriptBox["k", "2"]}]}], ")"}], "6"], " ", 
       SuperscriptBox["pi", "3"]}]], ")"}], 
    RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.954446108885892*^9, 3.954446131226974*^9}, {
  3.9544462094756403`*^9, 3.954446237298799*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"c7d06ed6-c39e-4064-a184-f99c00c23b0d"],

Cell[BoxData[
 FractionBox[
  RowBox[{"512", " ", 
   SuperscriptBox["a0", "7"], " ", 
   SuperscriptBox["e", "2"], " ", 
   SuperscriptBox["E0", "2"], " ", 
   SuperscriptBox["k", "3"], " ", "m", " ", 
   SuperscriptBox["\[Pi]", "2"]}], 
  RowBox[{"3", " ", 
   SuperscriptBox["h", "3"], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox["a0", "2"], " ", 
       SuperscriptBox["k", "2"]}]}], ")"}], "6"], " ", 
   SuperscriptBox["pi", "3"]}]]], "Output",
 CellChangeTimes->{3.954446238310466*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"f374d9de-3e21-45c2-bb14-3fbb742015de"]
}, Open  ]],

