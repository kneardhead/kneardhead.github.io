Cell[BoxData[
 RowBox[{
  RowBox[{"Bx", " ", "Ex"}], "+", 
  RowBox[{"By", " ", "Ey"}], "+", 
  RowBox[{"Bz", " ", "Ez"}]}]], "Output",
 CellChangeTimes->{3.954582625963951*^9},
 CellLabel->"Out[38]=",ExpressionUUID->"fe993b26-8474-47f2-b435-ef7bce816499"]
}, Open  ]],

