Cell["Computing the integral for the total radiation", "Text",
 CellChangeTimes->{{3.954584970687636*^9, 
  3.954584978774701*^9}},ExpressionUUID->"9884b22e-f50a-4649-bcaa-\
f1eebbf41534"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"\[Beta]", " ", "*", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "2"}], " ", 
      "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"\[Beta]", "^", "2"}]}], ")"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}], ")"}], "^", "2"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}], ")"}], "^", "2"}]}]}], ")"}], 
    "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Beta]", "*", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "5"}], 
     ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0", ",", "Pi"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Phi]", ",", "0", ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9545849817442636`*^9, 3.95458508926543*^9}, {
  3.954585126529293*^9, 3.9545851271783543`*^9}, {3.954585245145336*^9, 
  3.9545852635884457`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"fa30dced-b0e9-45a6-9199-e102b7c54e8e"],

Cell[BoxData[
 TemplateBox[{
   FractionBox[
    RowBox[{
      SuperscriptBox["\[Pi]", "2"], " ", 
      SqrtBox[
       FractionBox["1", 
        RowBox[{"1", "-", "\[Beta]"}]]], " ", 
      RowBox[{"(", 
        RowBox[{"12", "+", 
          RowBox[{"7", " ", 
            SuperscriptBox["\[Beta]", "2"]}]}], ")"}]}], 
    RowBox[{"8", " ", 
      SuperscriptBox[
       RowBox[{"(", 
         RowBox[{
           RowBox[{"-", "1"}], "+", "\[Beta]"}], ")"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
         RowBox[{"1", "+", "\[Beta]"}], ")"}], 
       RowBox[{"5", "/", "2"}]]}]], 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", 
       StyleBox[
        TagBox[
         TooltipBox["\"condition\"", 
          TagBox[
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 RowBox[{"\[Beta]", "\[NotElement]", 
                   TemplateBox[{}, "Reals"]}], "||", 
                 RowBox[{
                   RowBox[{"-", "1"}], "\[LessEqual]", 
                   RowBox[{"Re", "[", "\[Beta]", "]"}], "\[LessEqual]", 
                   "1"}]}], ")"}], "&&", 
             RowBox[{"(", 
               RowBox[{
                 RowBox[{"\[Beta]", "\[NotElement]", 
                   TemplateBox[{}, "Reals"]}], "||", 
                 RowBox[{
                   RowBox[{"-", "1"}], "<", 
                   RowBox[{"Re", "[", "\[Beta]", "]"}], "<", "0"}], "||", 
                 RowBox[{"0", "<", 
                   RowBox[{"Re", "[", "\[Beta]", "]"}], "<", "1"}]}], ")"}], 
             "&&", 
             RowBox[{"(", 
               RowBox[{
                 RowBox[{
                   RowBox[{"ArcCsc", "[", "\[Beta]", "]"}], "\[NotElement]", 
                   TemplateBox[{}, "Reals"]}], "||", 
                 RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{"ArcSec", "[", "\[Beta]", "]"}], "]"}], "<", 
                   "0"}], "||", 
                 RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{"ArcSec", "[", "\[Beta]", "]"}], "]"}], ">", 
                   "\[Pi]"}]}], ")"}]}], Short[#, 7]& ]], Annotation[#, 
          Short[
           And[
            Or[
             NotElement[$CellContext`\[Beta], Reals], 
             Inequality[-1, LessEqual, 
              Re[$CellContext`\[Beta]], LessEqual, 1]], 
            Or[
             NotElement[$CellContext`\[Beta], Reals], 
             Inequality[-1, Less, 
              Re[$CellContext`\[Beta]], Less, 0], 
             Inequality[0, Less, 
              Re[$CellContext`\[Beta]], Less, 1]], 
            Or[
             NotElement[
              ArcCsc[$CellContext`\[Beta]], Reals], Re[
               ArcSec[$CellContext`\[Beta]]] < 0, Re[
               ArcSec[$CellContext`\[Beta]]] > Pi]], 7], "Tooltip"]& ], 
        "IconizedCustomName", StripOnInput -> False], 
       GridBox[{{
          RowBox[{
            TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            TagBox["And", "IconizedItem"]}]}, {
          RowBox[{
            TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
            
            TagBox["1264", "IconizedItem"]}]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]}, "IconizedObject"]], 
    And[
     Or[
      NotElement[$CellContext`\[Beta], Reals], 
      Inequality[-1, LessEqual, 
       Re[$CellContext`\[Beta]], LessEqual, 1]], 
     Or[
      NotElement[$CellContext`\[Beta], Reals], 
      Inequality[-1, Less, 
       Re[$CellContext`\[Beta]], Less, 0], 
      Inequality[0, Less, 
       Re[$CellContext`\[Beta]], Less, 1]], 
     Or[
      NotElement[
       ArcCsc[$CellContext`\[Beta]], Reals], Re[
        ArcSec[$CellContext`\[Beta]]] < 0, Re[
        ArcSec[$CellContext`\[Beta]]] > Pi]], SelectWithContents -> True, 
    Selectable -> False]},
  "ConditionalExpression"]], "Output",
 CellChangeTimes->{3.954585094466641*^9, 3.954585171637835*^9, 
  3.954585307861085*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"31c1d9a2-116a-4a1e-b46f-8096d4541829"]
}, Open  ]],

