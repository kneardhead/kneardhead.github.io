Cell["\<\
Below we plot the required radiation. At first we plot what we got for this \
problem (0.5 and 0.2 beta values), then we will plot what we found for \
Bremstrahlung.\
\>", "Text",
 CellChangeTimes->{{3.954585544738742*^9, 3.954585576666441*^9}, {
  3.954585622090563*^9, 
  3.954585626984255*^9}},ExpressionUUID->"81e38db2-f17d-4639-8dec-\
471ab3abeb4b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"\[Beta]", "=", "0.5"}], "\[IndentingNewLine]", 
 RowBox[{"SphericalPlot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
