Cell[BoxData[{
 RowBox[{"\[Beta]", "=", "0.5"}], "\[IndentingNewLine]", 
 RowBox[{"SphericalPlot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
