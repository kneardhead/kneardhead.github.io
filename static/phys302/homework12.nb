Cell["First let\[CloseCurlyQuote]s compute E\[CloseCurlyQuote]^2 - c^2 B\
\[CloseCurlyQuote]^2", "Text",
 CellChangeTimes->{{3.954582820523745*^9, 
  3.9545828302370033`*^9}},ExpressionUUID->"c785193b-6188-483d-98c3-\
8d99e57a2215"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"Ex", "'"}], "*", 
     RowBox[{"Ex", "'"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Ey", "'"}], "*", 
     RowBox[{"Ey", "'"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"Ez", "'"}], "*", 
     RowBox[{"Ez", "'"}]}]}], ")"}], "-", 
  RowBox[{
   RowBox[{"c", "^", "2"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Bx", "'"}], "*", 
      RowBox[{"Bx", "'"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"By", "'"}], "*", 
      RowBox[{"By", "'"}]}], "+", 
     RowBox[{
      RowBox[{"Bz", "'"}], "*", 
      RowBox[{"Bz", "'"}]}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.954582854158757*^9, 3.9545828645509443`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"52e85c2f-b3af-41ea-9eda-1568cd41f3ea"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["Ex", "2"], "+", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Ez", "+", 
      RowBox[{"By", " ", "v"}]}], ")"}], "2"], 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["v", "2"], 
     SuperscriptBox["c", "2"]]}]], "+", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"Ey", "-", 
      RowBox[{"Bz", " ", "v"}]}], ")"}], "2"], 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["v", "2"], 
     SuperscriptBox["c", "2"]]}]], "-", 
  RowBox[{
   SuperscriptBox["c", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["Bx", "2"], "+", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Bz", "-", 
         FractionBox[
          RowBox[{"Ey", " ", "v"}], 
          SuperscriptBox["c", "2"]]}], ")"}], "2"], 
      RowBox[{"1", "-", 
       FractionBox[
        SuperscriptBox["v", "2"], 
        SuperscriptBox["c", "2"]]}]], "+", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"By", "+", 
         FractionBox[
          RowBox[{"Ez", " ", "v"}], 
          SuperscriptBox["c", "2"]]}], ")"}], "2"], 
      RowBox[{"1", "-", 
       FractionBox[
        SuperscriptBox["v", "2"], 
        SuperscriptBox["c", "2"]]}]]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.954582865239298*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"2562b4cb-5353-4446-abc8-00000d2e1878"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Ex", "'"}], "*", 
      RowBox[{"Ex", "'"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"Ey", "'"}], "*", 
      RowBox[{"Ey", "'"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"Ez", "'"}], "*", 
      RowBox[{"Ez", "'"}]}]}], ")"}], "-", 
   RowBox[{
    RowBox[{"c", "^", "2"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Bx", "'"}], "*", 
       RowBox[{"Bx", "'"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"By", "'"}], "*", 
       RowBox[{"By", "'"}]}], "+", 
      RowBox[{
       RowBox[{"Bz", "'"}], "*", 
       RowBox[{"Bz", "'"}]}]}], ")"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.954582742367188*^9, 3.9545828107348623`*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"70806733-5225-4208-a03a-c1b1d555e196"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["Bx", "2"], "+", 
       SuperscriptBox["By", "2"], "+", 
       SuperscriptBox["Bz", "2"]}], ")"}], " ", 
     SuperscriptBox["c", "2"]}], ")"}]}], "+", 
  SuperscriptBox["Ex", "2"], "+", 
  SuperscriptBox["Ey", "2"], "+", 
  SuperscriptBox["Ez", "2"]}]], "Output",
 CellChangeTimes->{3.954582834159102*^9},
 CellLabel->"Out[40]=",ExpressionUUID->"3589d6b2-b4f0-48b0-9c60-bfc7c7a9a84f"]
}, Open  ]],

Cell["\<\
Full Simplification shows that we have gotten the non-prime factors of E_i, \
B_j intact, that means that the spacetime-interval like quantity E^2 - c^2 \
B^2 is invariant.\
\>", "Text",
 CellChangeTimes->{{3.9545828844393787`*^9, 
  3.954582929130972*^9}},ExpressionUUID->"1369ab1e-20e6-418b-b2e1-\
e9221bf5b0bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Problem 6 (c) ", "Subtitle",
 CellChangeTimes->{{3.954582986070169*^9, 
  3.954582990509644*^9}},ExpressionUUID->"b85bf4bd-c9f8-4194-8434-\
d0bc4730ff14"],

Cell["\<\
Answer: No

Reason: For one system if B=0 then S^2 = E^2 - c^2 B^2 = E^2 > 0 which \
implies S^2 > 0
But now for another system where E = 0 we get S^2 = - c^2 B^2 which implies \
S^2 < 0

But we know that S^2 is conserved for all frames, hence it can\
\[CloseCurlyQuote]t be greater and lower than zero for the same system in two \
different frames. This means the answer to the question is NO. \
\>", "Text",
 CellChangeTimes->{{3.954583006312689*^9, 
  3.9545831217724953`*^9}},ExpressionUUID->"9955fbec-a912-4e39-b16e-\
dfaad15706ad"]
}, Open  ]]
},
