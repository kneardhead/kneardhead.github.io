         RowBox[{"Sin", "[", "\[Theta]", "]"}], ")"}], "^", "2"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}], ")"}], "^", "2"}]}]}], ")"}], 
    "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"\[Beta]", "*", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], "^", "5"}], 
     ")"}]}], ",", " ", 
   RowBox[{"{", 
