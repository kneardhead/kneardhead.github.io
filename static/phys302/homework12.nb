Cell["Below we compute the expanded form of vec(E)*vec(B)", "Text",
 CellChangeTimes->{{3.9545826583733397`*^9, 
  3.9545826701090927`*^9}},ExpressionUUID->"2758adab-4335-4fc0-b6e1-\
259c3464f022"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Ex", "'"}], "*", 
   RowBox[{"Bx", "'"}]}], " ", "+", " ", 
  RowBox[{
   RowBox[{"Ey", "'"}], "*", 
   RowBox[{"By", "'"}]}], "+", 
  RowBox[{
   RowBox[{"Ez", "'"}], "*", 
   RowBox[{"Bz", "'"}]}]}]], "Input",
 CellChangeTimes->{{3.954582431738805*^9, 3.9545824622355623`*^9}, {
  3.954582561372634*^9, 3.954582566795476*^9}, {3.954582628431547*^9, 
  3.954582629905588*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"38c9675b-20c6-4118-9a99-dc2df4b4403e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Bx", " ", "Ex"}], "+", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Ez", "+", 
      RowBox[{"By", " ", "v"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"Bz", "-", 
      FractionBox[
       RowBox[{"Ey", " ", "v"}], 
       SuperscriptBox["c", "2"]]}], ")"}]}], 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["v", "2"], 
     SuperscriptBox["c", "2"]]}]], "+", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Ey", "-", 
      RowBox[{"Bz", " ", "v"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"By", "+", 
      FractionBox[
       RowBox[{"Ez", " ", "v"}], 
       SuperscriptBox["c", "2"]]}], ")"}]}], 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["v", "2"], 
     SuperscriptBox["c", "2"]]}]]}]], "Output",
 CellChangeTimes->{{3.9545824499743958`*^9, 3.954582469345524*^9}, 
   3.954582523260515*^9, 3.954582567616807*^9, {3.954582612207993*^9, 
   3.9545826325421124`*^9}},
 CellLabel->"Out[39]=",ExpressionUUID->"a578e513-68fa-4212-984c-7b5a9a94a71d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Ex", "'"}], "*", 
    RowBox[{"Bx", "'"}]}], " ", "+", " ", 
   RowBox[{
    RowBox[{"Ey", "'"}], "*", 
    RowBox[{"By", "'"}]}], "+", 
